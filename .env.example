# Copy to .env at the repository root. Never commit the real .env file.
# Backend only. Restart the backend after changing these values.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional comma-separated exact HTTPS frontend origins. Local Vite is always allowed.
PAPERLENS_ALLOWED_ORIGINS=

# Public frontend configuration only. Restart Vite or rebuild the frontend after changing it.
VITE_API_BASE_URL=http://localhost:8000
